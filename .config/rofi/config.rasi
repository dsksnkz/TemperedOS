configuration {
    modi: "drun,run,window";
    show-icons: true;
    display-drun: "Apps";
    display-run: "Commands";
    display-window: "Windows";
    drun-display-format: "{name}";
    matching: "fuzzy";
    sort: true;
    click-to-exit: true;
}

@import "palette.rasi"

* {
    font: "Inter 11";
    background-color: transparent;
    text-color: @tempered-fg;
    spacing: 0;
}

window {
    width: 48%;
    height: 56%;
    location: center;
    anchor: center;
    border: 1px;
    border-color: @tempered-border;
    border-radius: 24px;
    background-color: @tempered-bg;
    padding: 10px;
}

mainbox { children: [ inputbar, body, message ]; spacing: 10px; }

inputbar {
    padding: 15px 18px;
    border-radius: 18px;
    background-color: @tempered-surface;
    children: [ prompt, entry ];
}

prompt {
    text-color: @tempered-accent;
    font: "JetBrainsMono Nerd Font 13";
    padding: 0 14px 0 0;
}

entry {
    placeholder: "find an action, app, or open window";
    placeholder-color: @tempered-muted;
}

body { orientation: horizontal; spacing: 10px; children: [ mode-switcher, listview ]; }

mode-switcher {
    width: 108px;
    orientation: vertical;
    spacing: 6px;
    padding: 6px;
    border-radius: 18px;
    background-color: @tempered-surface;
}

button {
    padding: 12px 10px;
    border-radius: 13px;
    text-color: @tempered-muted;
    background-color: transparent;
}

button selected {
    text-color: @tempered-fg;
    background-color: @tempered-raised;
}

listview {
    lines: 8;
    columns: 1;
    fixed-height: true;
    scrollbar: false;
    spacing: 5px;
    padding: 6px;
    border-radius: 18px;
    background-color: @tempered-surface;
}

element {
    padding: 10px 12px;
    border-radius: 14px;
    background-color: transparent;
}

element selected {
    background-color: @tempered-accent;
    text-color: @tempered-bg;
}

element-icon { size: 26px; margin: 0 12px 0 0; }
element-text { vertical-align: 0.5; text-color: inherit; }
message { padding: 8px 14px; border-radius: 13px; background-color: @tempered-surface; }
